#include <bits/stdc++.h>
using namespace std;

void checkPrime(int number)
{
    bool isPrime = true;

    if (number <= 1)
    {
        isPrime = false;
    }
    else
    {
        for (int i = 2; i < number; i++)
        {
            if (number % i == 0)
            {
                isPrime = false;
                break;
            }
        }
    }

    if (isPrime)
        cout << "Is the number " << number << " a Prime number? Yes" << endl;
    else
        cout << "Is the number " << number << " a Prime number? No" << endl;
}

int main()
{
    int number;

    cout << "Enter number: ";
    cin >> number;

    checkPrime(number);

    return 0;
}